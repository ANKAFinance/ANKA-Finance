# Flask
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-jwt-secret
FLASK_DEBUG=0
APP_URL=https://financetracker.app
APP_NAME=Personal Finance Tracker
SUPPORT_EMAIL=support@financetracker.app
PRIVACY_URL=https://financetracker.app/privacy
TERMS_URL=https://financetracker.app/terms

# Database (optional — defaults to local app data folder)
# FINANCE_TRACKER_DB=/path/to/finance.db

# Default currency for new users
DEFAULT_CURRENCY=USD

# Stripe (global web + mobile web checkout)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_FAMILY=price_...

# Mobile in-app purchase verification
APPLE_SHARED_SECRET=your-apple-shared-secret
GOOGLE_PLAY_PACKAGE=com.advait.personalfinancetracker
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/secure/path/google-play-service-account.json
